<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Educa - Cadastro de Alunos</title>

    <style>
        body {
            background: #f3f6fb;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center; 
            margin: 0;
            padding: 20px 0;
        }

        .container-main {
            background: white;
            width: 500px; 
            max-width: 95%; 
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0,0,0,0.15);
            text-align: center;
        }

        .logo-box {
            margin-bottom: 20px;
        }

        .logo-box img {
            width: 180px;
            max-height: 180px;
            border-radius: 10px;
        }

        h2 {
            margin-bottom: 20px;
            color: #333;
        }

    
        .container-input input {
            width: 100%;
            padding: 10px;
            margin: 6px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
        }

        /* Botões */
        .container-button button {
            width: 30%;
            padding: 10px;
            margin: 5px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background-color: #4a6cf7;
            color: white;
            font-weight: bold;
            transition: background-color 0.3s;
        }

        .container-button button:hover {
            background-color: #3b58c4;
        }

        /* Responsividade */
        @media(max-width: 600px) {
            .container-button button {
                width: 80%;
            }
        }
    </style>
</head>

<body>
    <div class="container-main">

        <!-- Imagem do topo -->
        <div class="logo-box">
            <img src="https://static.vecteezy.com/system/resources/previews/024/781/754/original/cartoon-graduate-students-icon-free-png.png" 
                 alt="Imagem de Estudantes">
        </div>

        <h2>CADASTRO DE ALUNOS</h2>

        <form action="#" method="POST">
            <div class="container-input container-interno">
                <input type="text" name="nome" placeholder="Nome" required>
                <input type="text" name="matricula" placeholder="Matrícula" required>
                <input type="number" name="idade" placeholder="Idade" required>
                <input type="date" name="data_de_nascimento" required>
                <input type="text" name="rg" placeholder="RG" required>
                <input type="text" name="cpf" placeholder="CPF" required>
                <input type="text" name="rua" placeholder="Rua" required>
                <input type="text" name="bairro" placeholder="Bairro" required>
                <input type="text" name="cidade" placeholder="Cidade" required>
                <input type="text" name="uf" placeholder="UF" maxlength="2" required>
                <input type="text" name="curso" placeholder="Curso" required>
                <input type="text" name="telefone" placeholder="Telefone" required>
            </div>

            <div class="container-button container-interno">
                <button type="submit" name="acao" value="cadastrar">Cadastrar</button>
                <button type="submit" name="acao" value="editar">Editar</button>
                <button type="submit" name="acao" value="remover">Remover</button>
            </div>
        </form>
    </div>
</body>
</html>
